{
  "name": "glosse-nail-app",
  "main": "expo-router/entry",
  "version": "1.0.1",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "lint:staged": "lint-staged",
    "prepare": "husky",
    "typecheck": "tsc --noEmit && tsc --noEmit -p convex/tsconfig.json",
    "lint:backend": "eslint convex --ignore-pattern 'convex/_generated/**' --max-warnings 0",
    "test:backend": "vitest run",
    "test:app": "jest --runInBand",
    "verify:backend": "npm run typecheck && npm run lint:backend && npm run test:backend",
    "verify:app": "npm run lint -- --no-cache --max-warnings 0 && npm run test:app",
    "verify:quality": "npm run verify:backend && npm run verify:app"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@convex-dev/auth": "^0.0.95",
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "15.1.1",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/netinfo": "12.0.1",
    "convex": "^1.46.0",
    "expo": "~57.0.26",
    "expo-auth-session": "~57.0.13",
    "expo-constants": "~57.0.19",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.11",
    "expo-navigation-bar": "~57.0.3",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-paper": "^5.15.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "^3.7.0",
    "uniwind": "^1.12.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@edge-runtime/vm": "^5.0.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/node": "^24.13.6",
    "@types/react": "~19.2.18",
    "convex-test": "^0.0.59",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "expo-mcp": "~0.2.1",
    "husky": "^9.1.7",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "lint-staged": "^16.4.0",
    "tailwindcss": "~4.3.3",
    "typescript": "~6.0.3",
    "vitest": "^5.0.1"
  },
  "private": true,
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,mts,cjs,cts}": "eslint --max-warnings 0 --no-warn-ignored"
  }
}
