{
	"extends": "expo/tsconfig.base",
	"compilerOptions": {
		"strict": true,
		"ignoreDeprecations": "6.0",
		"types": ["expo/types"],
		"paths": {
			"@/*": ["./*"],
			"*": ["./*"]
		}
	},
	"include": [
		"**/*.ts",
		"**/*.tsx",
		"vitest.config.mts",
		".expo/types/**/*.ts",
		"expo-env.d.ts"
	]
}
